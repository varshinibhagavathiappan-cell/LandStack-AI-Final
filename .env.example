# LandStack AI - environment template (NEVER put real secrets in Git)
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEMO_MODE=false
DATABASE_URL=sqlite:///./landstack.db
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_MAPS_API_KEY=

# OpenStreetMap public services (no key). Keep user-triggered geocoding and rate-limit requests.
OSM_USER_AGENT=LandStackAI/5.0 (citizen land decision copilot)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
KNOWLEDGE_BASE_PATH=./knowledge_base
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Frontend-only public map key. Use only a key intended for browser use and restrict it in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=

# OpenStreetMap public services (no key). Keep user-triggered geocoding and rate-limit requests.
OSM_USER_AGENT=LandStackAI/5.0 (citizen land decision copilot)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
VITE_API_BASE_URL=http://127.0.0.1:8000/api
